generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Setting {
  key   String @id
  value String
}

model ProcessLog {
  id           String   @id @default(cuid())
  originalName String
  originalPath String
  targetPath   String?
  tmdbId       Int?
  tmdbName     String?
  status       String   // "SUCCESS", "FAILED", "IGNORED"
  errorMessage String?
  createdAt    DateTime @default(now())
}
